<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <permission android:name="com.jruiz.nexo.permission.NEXO_CONNECT_MIGRATION" android:protectionLevel="signature" />
    <uses-permission android:name="com.jruiz.nexo.permission.NEXO_CONNECT_MIGRATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <queries>
        <package android:name="com.jruiz.nexo.connect.pilot" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Nexo"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <provider android:name="com.jruiz.nexo.connectui.NexoConnectInvitationProvider" android:authorities="com.jruiz.nexo.connectinvites" android:exported="false" android:grantUriPermissions="true"><meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/connect_invite_paths" /></provider>
        <activity android:name="com.jruiz.nexo.connectui.NexoConnectInvitationActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><data android:mimeType="application/vnd.nexo.invitation"/></intent-filter>
            <intent-filter><action android:name="android.intent.action.SEND"/><category android:name="android.intent.category.DEFAULT"/><data android:mimeType="application/vnd.nexo.invitation"/></intent-filter>
        </activity>
        <activity android:name="com.jruiz.nexo.connectui.NexoConnectActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.jruiz.nexo.connectui.NexoConnectMigrationActivity" android:exported="false" />
        <service android:name="com.jruiz.nexo.connect.vault.NexoConnectInboxNoticeJob" android:exported="true" android:permission="android.permission.BIND_JOB_SERVICE" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:label="Guardar en Nexo">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="Guardar en Nexo">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/html" />
            </intent-filter>
            <intent-filter android:label="Guardar en Nexo">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="Guardar en Nexo">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <intent-filter android:label="Abrir contenido de Nexo">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-nexo-share" />
            </intent-filter>
            <intent-filter android:label="Abrir contenido de Nexo">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/x-nexo-share" />
            </intent-filter>
            <!-- Algunos gestores de archivos (incluido Samsung My Files)
                 publican extensiones personalizadas como application/octet-stream.
                 Nexo valida después el nombre y el contenido antes de importar. -->
            <intent-filter android:label="Abrir contenido de Nexo">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter android:label="Abrir contenido de Nexo">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter android:label="Importar calendario en Nexo">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/calendar" />
            </intent-filter>
            <intent-filter android:label="Importar calendario en Nexo">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/calendar" />
            </intent-filter>
            <intent-filter android:label="Importar calendario en Nexo">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/ics" />
            </intent-filter>
            <intent-filter android:label="Importar calendario en Nexo">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/ics" />
            </intent-filter>
        </activity>



        <service
            android:name=".recordings.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="false" />

        <service
            android:name=".transcription.TranscriptionService"
            android:exported="false"
            android:process=":transcription"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <service
            android:name=".communications.NexoNotificationListener"
            android:label="Nexo Inbox"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".calendar.CalendarWatchJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <service
            android:name=".input.SmsWatchJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <service
            android:name=".input.GmailWatchJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <receiver
            android:name=".communications.InboxNotificationReceiver"
            android:exported="false" />

        <provider
            android:name=".documents.DocumentProvider"
            android:authorities="com.jruiz.nexo.documents"
            android:exported="false"
            android:grantUriPermissions="true" />

        <provider
            android:name=".recordings.RecordingProvider"
            android:authorities="com.jruiz.nexo.recordings"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".updates.NexoUpdateJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <provider
            android:name=".updates.NexoUpdateApkProvider"
            android:authorities="com.jruiz.nexo.updates"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver android:name=".reminders.AlarmReceiver" android:exported="false" />
        <receiver android:name=".medications.MedicationAlarmReceiver" android:exported="false" />
        <receiver android:name=".medications.MedicationActionReceiver" android:exported="false" />
        <receiver android:name=".reminders.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
