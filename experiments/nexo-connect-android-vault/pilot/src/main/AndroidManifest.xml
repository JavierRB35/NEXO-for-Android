<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 14+: JobScheduler network constraints require this permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Consent is requested in the pilot UI, never silently. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Required for the OS to restore the persisted periodic check. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-permission android:name="com.jruiz.nexo.permission.NEXO_CONNECT_DEBUG_BRIDGE"/>
    <uses-permission android:name="com.jruiz.nexo.permission.NEXO_CONNECT_MIGRATION"/>
    <queries><package android:name="com.jruiz.nexo"/></queries>
    <application android:label="Nexo Connect Pruebas"
        android:allowBackup="false" android:usesCleartextTraffic="false"
        android:supportsRtl="true">
        <activity android:name="com.jruiz.nexo.connect.vault.NexoConnectMigrationExportActivity" android:exported="true" android:permission="com.jruiz.nexo.permission.NEXO_CONNECT_MIGRATION" />
        <service android:name="com.jruiz.nexo.connect.vault.NexoConnectMigrationService" android:exported="true" android:permission="com.jruiz.nexo.permission.NEXO_CONNECT_MIGRATION" />
        <!-- OS-managed periodic background check. Not an instant push service. -->
        <service android:name="com.jruiz.nexo.connect.vault.NexoConnectInboxNoticeJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- LAB only: same-signature Nexo can pull one user-approved, verified
             received list. The service never exports the pilot Keystore. -->
        <service android:name="com.jruiz.nexo.connect.vault.NexoConnectReceivedBridgeService"
            android:exported="true"
            android:permission="com.jruiz.nexo.permission.NEXO_CONNECT_DEBUG_BRIDGE" />
        <activity android:name="com.jruiz.nexo.connect.vault.NexoConnectPilotActivity"
            android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name="com.jruiz.nexo.connect.vault.NexoConnectPilotBridgeActivity"
            android:exported="true" android:screenOrientation="portrait"/>
    </application>
</manifest>
