<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-permission android:name="com.jruiz.nexo.permission.NEXO_CONNECT_DEBUG_BRIDGE"/>
    <queries><package android:name="com.jruiz.nexo"/></queries>
    <application android:label="Nexo Connect Pruebas"
        android:allowBackup="false" android:usesCleartextTraffic="false"
        android:supportsRtl="true">
        <!-- LAB only: same-signature Nexo can pull one user-approved, verified
             received list. The service never exports the pilot Keystore. -->
        <service android:name="com.jruiz.nexo.connect.vault.NexoConnectReceivedBridgeService"
            android:exported="true"
            android:permission="com.jruiz.nexo.permission.NEXO_CONNECT_DEBUG_BRIDGE" />
        <activity android:name="com.jruiz.nexo.connect.vault.NexoConnectPilotActivity"
            android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name="com.jruiz.nexo.connect.vault.NexoConnectPilotBridgeActivity"
            android:exported="true" android:screenOrientation="portrait"/>
    </application>
</manifest>
